COMPOSE_PROFILES=local-postgres,local-queue
POSTGRES_PASSWORD=replace-with-random-local-value
DATABASE_URL=postgresql://ovo:replace-with-random-local-value@postgres:5432/ovo
OVO_ORGANIZATION_ID=ovo
OVO_ADMIN_ID=first-admin
OVO_ADMIN_LABEL=First administrator
OVO_ALLOW_LOCAL_HTTP=true
OVO_SESSION_SECRET=replace-with-a-long-random-session-secret
OVO_SEED_ADMIN_EMAIL=admin@example.com
OVO_SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
OVO_SEED_ADMIN_LABEL=First administrator
OVO_RESTORE_ADMIN_RECOVERY=false
OVO_MEDIA_PUBLIC_BASE_URL=https://voice.example.com
OVO_MEDIA_WORKER_TOKEN=replace-with-a-long-random-internal-token
OVO_SECRETS_MASTER_KEY=replace-with-32-byte-hex-or-base64-key
# Set only while rotating the master key, until secrets-rewrap reports every credential current.
OVO_SECRETS_MASTER_KEY_PREVIOUS=
OVO_SECRETS_BACKEND=encrypted-store
OVO_PLUGIN_MODULES=[]
# debug | info | warn | error, for every service's JSON-lines log.
OVO_LOG_LEVEL=info
# store | omit caller and agent words in call events and per-turn telemetry; per-agent overrides
# as agent-id=omit,other-id=store.
OVO_TELEMETRY_TRANSCRIPT_TEXT=store
OVO_TELEMETRY_TRANSCRIPT_TEXT_AGENTS=
OVO_RECORDING_RETENTION_DAYS=30
OVO_INBOUND_ENABLED=false
OVO_INBOUND_ROUTE_SECRET=replace-with-at-least-32-random-characters
OVO_LIVE_DIAL_ENABLED=false
OVO_TRANSPORT_CERTIFIED=false
OVO_PROVIDER_EVALUATIONS_ENABLED=false
OVO_PERMITTED_FROM_NUMBERS=
POSTGRES_PORT=54329
ELASTICMQ_PORT=9324
API_PORT=4000
CONSOLE_PORT=3000
GATEWAY_PORT=4001
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
OVO_SQS_ENDPOINT=http://queue:9324
OVO_QUEUE_URL=http://queue:9324/000000000000/ovo-jobs
OVO_DLQ_URL=http://queue:9324/000000000000/ovo-jobs-dlq
OVO_API_IMAGE=ovo-api:local
OVO_CONSOLE_IMAGE=ovo-console:local
OVO_DISPATCHER_IMAGE=ovo-dispatcher:local
OVO_GATEWAY_IMAGE=ovo-gateway:local
OVO_WORKER_IMAGE=ovo-worker:local
# ElevenLabs TTS and Scribe STT keys are console credentials (provider "elevenlabs"), never env.
# Worker tuning variables added in Wave 2 (OVO_SPEECH_*, OVO_WORKER_DRAIN_TIMEOUT_MS,
# OVO_NET_KEEP_ALIVE_MS, OVO_PROVIDER_PREWARM, OVO_LLM_*) keep their documented defaults here:
# compose.yaml does not forward them yet.
# Not read by Compose; carrier credentials belong in the console's credential store.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
