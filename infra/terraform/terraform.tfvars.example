aws_region                = "ap-south-1"
environment               = "staging"
vpc_id                    = "vpc-REPLACE"
vpc_cidr                  = "10.0.0.0/16"
public_subnet_ids          = ["subnet-public-a", "subnet-public-b"]
private_subnet_ids         = ["subnet-private-a", "subnet-private-b"]
certificate_arn            = "arn:aws:acm:ap-south-1:123456789012:certificate/REPLACE"
runtime_secret_arn         = "arn:aws:secretsmanager:ap-south-1:123456789012:secret:ovo/staging/runtime-REPLACE"
database_security_group_id = "sg-database"
api_image                  = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/ovo-api:immutable-digest"
console_image              = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/ovo-console:immutable-digest"
dispatcher_image           = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/ovo-dispatcher:immutable-digest"
gateway_image              = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/ovo-gateway:immutable-digest"
worker_image               = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/ovo-worker:immutable-digest"
inbound_warm_floor         = 2
worker_max_capacity        = 100
