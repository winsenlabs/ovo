{
  "name": "@winsendotai/ovo-voice-experiments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Disposable comparative voice-engine spikes; not production runtime code.",
  "scripts": {
    "benchmark": "tsx src/benchmark.ts",
    "check": "pnpm check:size && pnpm typecheck && pnpm test",
    "check:size": "node scripts/check-size.mjs",
