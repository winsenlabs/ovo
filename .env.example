# Use pnpm setup:local to generate random private development keys.
# Do not use the SQLite profile on Fargate or for production calls.
OVO_ADMIN_TOKEN=
OVO_SESSION_SECRET=
OVO_SECRETS_MASTER_KEY=
OVO_ADMIN_WORKSPACE_ID=local
OVO_DATABASE_FILE=../../.data/ovo.sqlite
OVO_SECRETS_BACKEND=local
OVO_API_URL=http://127.0.0.1:4000
NEXT_ALLOWED_DEV_ORIGINS=
# Wave 15 routing points and agent pools (docs/architecture/routing.md); off by default.
OVO_ROUTING_ENABLED=false
OVO_ROUTING_EXTERNAL_ENABLED=false
# Wave 16 in-call agent transfer on routed calls; off by default.
OVO_ROUTING_TRANSFER_ENABLED=false
# Wave 18 route tester: real decision and LLM engines in a simulation (admin only, costs money); off.
OVO_ROUTING_SIMULATE_LIVE_ENABLED=false
# Simulations and eval runs one identity may start a minute, 1-600.
OVO_ROUTING_SIMULATE_RATE_PER_MINUTE=30
# Wave 17 human queues (docs/architecture/human-queues.md); off by default. Needs the two routing
# flags above. Off: `human` steps are skipped and /v1/human-queues, /v1/desk answer 404.
OVO_HUMAN_QUEUE_ENABLED=false
# Third-party queues post a signed webhook only with this on.
OVO_HUMAN_QUEUE_WEBHOOK_ENABLED=false
# The OVO-managed operator desk needs the self-hosted room server (docs/runbooks/livekit-deploy.md).
OVO_LIVEKIT_ENABLED=false
