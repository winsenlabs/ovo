# Use pnpm setup:local to generate random private development keys.
# Do not use the SQLite profile on Fargate or for production calls.
OVO_ADMIN_TOKEN=
OVO_SESSION_SECRET=
OVO_SECRETS_MASTER_KEY=
OVO_ADMIN_WORKSPACE_ID=local
OVO_DATABASE_FILE=../../.data/ovo.sqlite
OVO_SECRETS_BACKEND=local
OVO_API_URL=http://127.0.0.1:4000
NEXT_ALLOWED_DEV_ORIGINS=
# Wave 15 routing points and agent pools (docs/architecture/routing.md); off by default.
OVO_ROUTING_ENABLED=false
OVO_ROUTING_EXTERNAL_ENABLED=false
# Wave 16 in-call agent transfer on routed calls; off by default.
OVO_ROUTING_TRANSFER_ENABLED=false
