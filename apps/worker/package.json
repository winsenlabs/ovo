{
  "name": "@winsendotai/ovo-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --loader:.sql=text --outfile=dist/main.cjs --target=node24 --external:@livekit/* --external:sharp --external:onnxruntime-node",
    "start": "node dist/main.cjs",
    "build:turn-worker": "esbuild ../../packages/plugin-turn-detector-smart-turn/src/inference-worker.ts --bundle --platform=node --format=esm --target=node24 --external:onnxruntime-node --outfile=dist/smart-turn-worker.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.9.0",
    "@livekit/protocol": "1.51.0",
    "@livekit/rtc-node": "0.13.34",
    "@winsendotai/ovo-behaviors": "workspace:*",
    "@winsendotai/ovo-contracts": "workspace:*",
    "@winsendotai/ovo-distribution": "workspace:*",
    "@winsendotai/ovo-plugin-cache": "workspace:*",
    "@winsendotai/ovo-plugin-kit": "workspace:*",
    "@winsendotai/ovo-plugin-ledger": "workspace:*",
    "@winsendotai/ovo-plugin-media": "workspace:*",
    "@winsendotai/ovo-plugin-observability": "workspace:*",
    "@winsendotai/ovo-plugin-operations": "workspace:*",
    "@winsendotai/ovo-plugin-orchestration": "workspace:*",
    "@winsendotai/ovo-plugin-recordings": "workspace:*",
    "@winsendotai/ovo-plugin-router": "workspace:*",
    "@winsendotai/ovo-plugin-secrets": "workspace:*",
    "@winsendotai/ovo-plugin-speech-cache": "workspace:*",
    "@winsendotai/ovo-plugin-storage": "workspace:*",
    "@winsendotai/ovo-plugin-tools-http": "workspace:*",
    "@winsendotai/ovo-plugin-voice": "workspace:*",
    "@winsendotai/ovo-runtime": "workspace:*",
    "@winsendotai/ovo-session-host": "workspace:*",
    "@winsendotai/ovo-sip-carrier-kit": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "ws": "8.21.3"
  }
}
